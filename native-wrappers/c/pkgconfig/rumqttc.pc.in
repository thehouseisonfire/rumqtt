prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: rumqttc
Description: Pre-stable dual-protocol rumqttc C client
Version: @RUMQTTC_PACKAGE_VERSION@
Libs: -L${libdir} -lrumqttc
Requires.private: @RUMQTTC_PKGCONFIG_REQUIRES_PRIVATE@
Libs.private: @RUMQTTC_PKGCONFIG_LIBS_PRIVATE@
Cflags: -I${includedir}
