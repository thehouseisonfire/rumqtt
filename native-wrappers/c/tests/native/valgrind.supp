# Rust's thread-local handle on a foreign main thread survives until process exit.
# Some toolchains insert Thread::new_current between new and init_current.
# Match only this possible leak; keep real client/driver leaks visible.
{
   rust-std-current-thread-handle-on-foreign-main-thread
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   ...
   fun:*std*thread*Thread*new*
   ...
   fun:*std*thread*current*init_current*
}

# x509-parser 0.18's lazy_static extension parser table lives until process exit.
# HashMap retains an interior pointer into its allocation, reported as possibly
# lost by Memcheck. Match only allocation during this specific static's init;
# certificate/client allocations and definite leaks must remain visible.
{
   x509-parser-process-lifetime-extension-parser-table
   Memcheck:Leak
   match-leak-kinds: possible
   fun:malloc
   ...
   fun:*hashbrown*raw*RawTableInner*new_uninitialized*
   ...
   fun:*x509_parser*extensions*parser*EXTENSION_PARSERS*static_ref_initialize*
}
