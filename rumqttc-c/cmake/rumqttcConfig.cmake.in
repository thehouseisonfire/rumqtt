@PACKAGE_INIT@

if(NOT TARGET rumqttc::rumqttc_static)
    add_library(rumqttc::rumqttc_static STATIC IMPORTED)
    set_target_properties(rumqttc::rumqttc_static PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/${CMAKE_STATIC_LIBRARY_PREFIX}rumqttc${CMAKE_STATIC_LIBRARY_SUFFIX}"
        INTERFACE_COMPILE_DEFINITIONS RUMQTTC_STATIC
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
        INTERFACE_LINK_LIBRARIES "@RUMQTTC_CMAKE_STATIC_LINK_LIBRARIES@")
endif()

if(NOT TARGET rumqttc::rumqttc_shared)
    add_library(rumqttc::rumqttc_shared SHARED IMPORTED)
    set_target_properties(rumqttc::rumqttc_shared PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/${CMAKE_SHARED_LIBRARY_PREFIX}rumqttc${CMAKE_SHARED_LIBRARY_SUFFIX}"
        INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
    if(WIN32)
        set_target_properties(rumqttc::rumqttc_shared PROPERTIES
            IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/${CMAKE_IMPORT_LIBRARY_PREFIX}rumqttc${CMAKE_SHARED_LIBRARY_SUFFIX}${CMAKE_IMPORT_LIBRARY_SUFFIX}")
    endif()
endif()

if(NOT TARGET rumqttc::rumqttc)
    add_library(rumqttc::rumqttc INTERFACE IMPORTED)
    set_property(TARGET rumqttc::rumqttc PROPERTY
        INTERFACE_LINK_LIBRARIES rumqttc::rumqttc_static)
endif()
check_required_components(rumqttc)
